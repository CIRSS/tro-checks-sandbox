REPRO_NAME=tro-checks-sandbox
REPRO_DOCKER_ORG=ghcr.io/cirss
REPRO_IMAGE_TAG=latest

DOCKER_BUILD_PROGRESS=plain

image:                  build-image   ##
start:                  start-repro   ##

##

# Add review-ledger's make reviews target if the review-ledger module has been initialized.
-include .review-ledger/host-makefile

## update-reviews:    Update REVIEWS.md without running the other reports.
update-reviews: session
	$(RUN_IN_REPRO) 'make -C ${REPRO_MNT}/.review-ledger -f report-makefile review'

## build-candidates:  Make the candidates with tro-utils from the arrangements and resources.
build-candidates: session
	$(RUN_IN_REPRO) 'bash make-candidates'

# The tier and version a declaration is checked against unless others are given.
TIER ?= STANDALONE-TRO
VERSION ?= trace-main

# For the "Check a pasted TRO declaration" workflow: check DECLARATION on its own and write its report to REPORT.
# Fails only if the declaration could not be checked, not if it misses its tier.
check-declaration: session
	$(RUN_IN_REPRO) 'mkdir -p "$$(dirname "${REPRO_MNT}/$(REPORT)")" && check-tro --candidate "${REPRO_MNT}/$(DECLARATION)" --report "${REPRO_MNT}/$(REPORT)" \
		--target-tier "$(TIER)" --target-version "$(VERSION)"; [ $$? -le 1 ]'

# Create a multi-architecture Docker image builder named multiarch unless one already exists.
create-image-builder:
	docker buildx inspect multiarch > /dev/null 2>&1 || \
		docker buildx create --name multiarch --driver docker-container

## publish-image:     Build the image for x86 and ARM and push it to ghcr.io.
publish-image: create-image-builder
	docker buildx build --builder multiarch \
		--platform linux/amd64,linux/arm64 \
		--annotation "index:org.opencontainers.image.source=https://github.com/CIRSS/tro-checks-sandbox" \
		--tag ${REPRO_IMAGE} \
		--push \
		--progress=${DOCKER_BUILD_PROGRESS} \
		.
